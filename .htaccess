# ==============================================================================
# Jaspreet Singh Dhaliwal Portfolio - Apache Security & Hardening Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CHARACTER ENCODING & DIRECTORY LISTING
# ------------------------------------------------------------------------------
# Prevent directory listing / information disclosure
Options -Indexes -MultiViews

# Disable server signature
ServerSignature Off

# Enforce UTF-8 default charset
AddDefaultCharset UTF-8

# Ensure proper trailing slash handling
DirectorySlash On

# ------------------------------------------------------------------------------
# 2. HTTP TO HTTPS ENFORCEMENT & CANONICAL ROUTING
# ------------------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Force HTTPS across standard and reverse proxy / Cloudflare / load balancer headers
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteCond %{HTTP:CF-Visitor} !'"scheme":"https"'
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Block access to hidden files and directories (including .git, .env)
    RewriteCond %{SCRIPT_FILENAME} -d [OR]
    RewriteCond %{SCRIPT_FILENAME} -f
    RewriteRule "(^|/)\.(?!well-known)" - [F,L]

    # Block common WordPress scan targets on this static mirror
    RewriteRule ^(wp-config\.php|xmlrpc\.php|wp-login\.php|wp-admin|readme\.html|license\.txt) - [F,L,NC]

    # Block malicious SQL injection, base64, and script injection strings in queries
    RewriteCond %{QUERY_STRING} (eval\(|base64_decode|base64_encode|GLOBALS|_REQUEST) [NC,OR]
    RewriteCond %{QUERY_STRING} (<|%3C).*script.*(>|%3E) [NC,OR]
    RewriteCond %{QUERY_STRING} (\.\./|\.\.\\) [NC,OR]
    RewriteCond %{QUERY_STRING} (concat.*\(|union.*select.*\(|union.*all.*select) [NC]
    RewriteRule ^(.*)$ - [F,L]

    # Block unauthorized HTTP methods
    RewriteCond %{REQUEST_METHOD} ^(TRACE|TRACK|DELETE|PUT|OPTIONS) [NC]
    RewriteRule ^(.*)$ - [F,L]

    # Fallback to index.html if requested static file/directory doesn't exist
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.html [L]
</IfModule>

# ------------------------------------------------------------------------------
# 3. HTTP SECURITY HEADERS
# ------------------------------------------------------------------------------
<IfModule mod_headers.c>
    # Prevent site from being embedded in iframes outside the domain (Clickjacking defense)
    Header set X-Frame-Options "SAMEORIGIN"

    # Block MIME-type sniffing
    Header set X-Content-Type-Options "nosniff"

    # Browser Cross-Site Scripting (XSS) Filter
    Header set X-XSS-Protection "1; mode=block"

    # Referrer policy to safeguard user privacy
    Header set Referrer-Policy "strict-origin-when-cross-origin"

    # HTTP Strict Transport Security (HSTS) - 1 Year with subdomains & preloading
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" env=HTTPS

    # Permissions Policy (restrict dangerous and unneeded hardware APIs)
    Header set Permissions-Policy "geolocation=(), midi=(), camera=(), microphone=(), payment=(), usb=(), display-capture=()"

    # Content Security Policy (CSP) tailored for Elementor, Google Fonts, and SVGs
    Header set Content-Security-Policy "default-src 'self' https: data: blob:; script-src 'self' 'unsafe-inline' 'unsafe-eval' https:; style-src 'self' 'unsafe-inline' https:; img-src 'self' data: blob: https:; font-src 'self' data: https:; connect-src 'self' https:; frame-ancestors 'self';"

    # Remove headers that expose server details
    Header unset X-Powered-By
</IfModule>

# ------------------------------------------------------------------------------
# 4. SENSITIVE FILE ACCESS RESTRICTIONS
# ------------------------------------------------------------------------------
# Deny access to .htaccess, .htpasswd, and hidden files
<FilesMatch "^\.ht">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Block access to backup, log, configuration, and sensitive developer files
<FilesMatch "(^#.*#|\.(bak|config|sql|fla|psd|ini|log|sh|inc|swp|dist|env|lock|gitignore)|~)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Prevent script execution in static directories
<FilesMatch "\.(php|php[0-9]|phtml|pl|py|jsp|asp|sh|cgi)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# ------------------------------------------------------------------------------
# 5. GZIP & BROTLI COMPRESSION (Performance & Resource Protection)
# ------------------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE font/ttf
    AddOutputFilterByType DEFLATE font/otf
    AddOutputFilterByType DEFLATE font/opentype
    AddOutputFilterByType DEFLATE application/x-font-ttf
    AddOutputFilterByType DEFLATE application/x-font-opentype
    AddOutputFilterByType DEFLATE application/vnd.ms-fontobject
</IfModule>

# ------------------------------------------------------------------------------
# 6. BROWSER CACHING (Performance Optimization)
# ------------------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"

    # HTML: Keep fresh
    ExpiresByType text/html "access plus 0 seconds"

    # Stylesheets & Scripts: 1 Year
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType application/x-javascript "access plus 1 year"

    # Media & Images: 1 Year
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"

    # Web Fonts: 1 Year
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
    ExpiresByType application/x-font-woff "access plus 1 year"
</IfModule>
